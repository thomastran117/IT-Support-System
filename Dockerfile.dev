# Development image shared by backend, worker and frontend.
# Dependencies are installed from the root lockfile and workspace manifests.
FROM node:22-alpine AS base
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY backend/package.json backend/
COPY worker/package.json worker/
COPY frontend/package.json frontend/
RUN npm ci

COPY tsconfig.base.json eslint.config.mjs ./
COPY packages/contracts packages/contracts
COPY packages/db packages/db
COPY backend/prisma backend/prisma
COPY backend/prisma.config.ts backend/
RUN npm run build -w packages/contracts -w packages/db

FROM base AS backend
COPY backend backend
EXPOSE 4000
CMD ["npm", "run", "dev", "-w", "backend"]

FROM base AS worker
COPY worker worker
CMD ["npm", "run", "dev", "-w", "worker"]

FROM base AS frontend
COPY frontend frontend
EXPOSE 3000
CMD ["npm", "run", "dev", "-w", "frontend"]
