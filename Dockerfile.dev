# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE} AS service-runtime
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/service-runtime/package.json packages/service-runtime/package-lock.json packages/service-runtime/
RUN npm ci --prefix packages/service-runtime
COPY packages/service-runtime/ packages/service-runtime/
RUN npm --prefix packages/service-runtime run build

FROM service-runtime AS gateway
WORKDIR /app/backend/gateway
COPY backend/gateway/package.json backend/gateway/package-lock.json ./
RUN npm ci
COPY --chown=node:node backend/gateway/ ./
RUN npm run build
USER node
EXPOSE 4000
CMD ["npm", "run", "dev"]

FROM ${NODE_IMAGE} AS ai-analysis-dependencies
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/ai-analysis/package.json packages/ai-analysis/package-lock.json packages/ai-analysis/
RUN npm ci --prefix packages/ai-analysis

FROM ai-analysis-dependencies AS ai-analysis
COPY packages/ai-analysis/ packages/ai-analysis/
RUN npm --prefix packages/ai-analysis run build

FROM service-runtime AS ai-service
WORKDIR /app
COPY --from=ai-analysis /app/packages/ai-analysis/ packages/ai-analysis/
COPY packages/contracts/package.json packages/contracts/package-lock.json packages/contracts/
RUN npm ci --prefix packages/contracts
COPY packages/contracts/ packages/contracts/
RUN npm --prefix packages/contracts run build
WORKDIR /app/backend/services/ai
COPY backend/services/ai/package.json backend/services/ai/package-lock.json ./
RUN npm ci
COPY backend/services/ai/ ./
RUN npm run build
USER node
EXPOSE 4010
CMD ["node", "dist/server.js"]

FROM ai-analysis-dependencies AS dependencies
WORKDIR /app

# Each package owns its lockfile. Local file dependencies only need the shared
# package manifests to be present while npm installs the consuming application.
COPY packages/contracts/package.json packages/contracts/package-lock.json packages/contracts/
COPY packages/db/package.json packages/db/package-lock.json packages/db/
COPY packages/analytics/package.json packages/analytics/package-lock.json packages/analytics/
COPY packages/identity/package.json packages/identity/package-lock.json packages/identity/
COPY packages/knowledge/package.json packages/knowledge/package-lock.json packages/knowledge/
COPY packages/notifications/package.json packages/notifications/package-lock.json packages/notifications/
COPY packages/service-runtime/package.json packages/service-runtime/package-lock.json packages/service-runtime/
COPY backend/package.json backend/package-lock.json backend/
COPY frontend/package.json frontend/package-lock.json frontend/
RUN npm ci --prefix packages/contracts \
  && npm ci --prefix packages/db \
  && npm ci --prefix packages/analytics \
  && npm ci --prefix packages/identity \
  && npm ci --prefix packages/knowledge \
  && npm ci --prefix packages/notifications \
  && npm ci --prefix packages/service-runtime \
  && npm ci --prefix backend \
  && npm ci --prefix frontend

FROM dependencies AS source
COPY . .
RUN npm --prefix packages/ai-analysis run build \
  && npm --prefix packages/contracts run build \
  && npm --prefix backend run generate \
  && npm --prefix packages/db run build \
  && npm --prefix packages/analytics run build \
  && npm --prefix packages/knowledge run build \
  && npm --prefix packages/notifications run build \
  && npm --prefix packages/service-runtime run build \
  && npm --prefix packages/identity run build

FROM source AS backend
WORKDIR /app/backend
EXPOSE 4000
CMD ["npm", "run", "dev"]

# The AI analysis worker is a second entrypoint of the backend package (same code, separate process).
FROM source AS worker
WORKDIR /app/backend
CMD ["npm", "run", "dev:worker"]

FROM service-runtime AS notifications-service
COPY --from=source /app/packages/contracts/ packages/contracts/
COPY --from=source /app/packages/db/ packages/db/
COPY --from=source /app/packages/notifications/ packages/notifications/
WORKDIR /app/backend/services/notifications
COPY backend/services/notifications/package.json backend/services/notifications/package-lock.json ./
RUN npm ci
COPY backend/services/notifications/ ./
RUN npm run build
USER node
EXPOSE 4020
CMD ["node", "dist/server.js"]

FROM service-runtime AS analytics-service
COPY --from=source /app/packages/contracts/ packages/contracts/
COPY --from=source /app/packages/db/ packages/db/
COPY --from=source /app/packages/analytics/ packages/analytics/
WORKDIR /app/backend/services/analytics
COPY backend/services/analytics/package.json backend/services/analytics/package-lock.json ./
RUN npm ci
COPY backend/services/analytics/ ./
RUN npm run build
USER node
EXPOSE 4030
CMD ["node", "dist/server.js"]

FROM service-runtime AS knowledge-service
COPY --from=ai-analysis /app/packages/ai-analysis/ packages/ai-analysis/
COPY --from=source /app/packages/contracts/ packages/contracts/
COPY --from=source /app/packages/db/ packages/db/
COPY --from=source /app/packages/knowledge/ packages/knowledge/
WORKDIR /app/backend/services/knowledge
COPY backend/services/knowledge/package.json backend/services/knowledge/package-lock.json ./
RUN npm ci
COPY backend/services/knowledge/ ./
RUN npm run build
USER node
EXPOSE 4040
CMD ["node", "dist/server.js"]

FROM service-runtime AS identity-service
COPY --from=source /app/packages/contracts/ packages/contracts/
COPY --from=source /app/packages/db/ packages/db/
COPY --from=source /app/packages/identity/ packages/identity/
WORKDIR /app/backend/services/identity
COPY backend/services/identity/package.json backend/services/identity/package-lock.json ./
RUN npm ci
COPY backend/services/identity/ ./
RUN npm run build
USER node
EXPOSE 4050
CMD ["node", "dist/server.js"]

FROM source AS frontend
WORKDIR /app/frontend
EXPOSE 3000
CMD ["npm", "run", "dev"]

FROM source AS format-check
WORKDIR /app
CMD ["./backend/node_modules/.bin/prettier", "--check", ".", "--config", ".prettierrc.json", "--ignore-path", ".prettierignore"]

FROM source AS backend-ci
WORKDIR /app
CMD ["sh", "/app/docker/verify-backend.sh"]

# Opt-in offline evaluation uses glibc for the local ONNX runtime.
FROM source AS hybrid-knowledge-experiment
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/* \
  && npm rebuild --prefix backend @prisma/engines \
  && npm ci --prefix backend/experiments/hybrid-knowledge
WORKDIR /app/backend
CMD ["./node_modules/.bin/tsx", "experiments/hybrid-knowledge/evaluate.ts"]

# Playwright's supported Ubuntu image supplies Chromium and its system libraries.
# Reinstall the frontend packages here so native dependencies match glibc rather
# than the Alpine stages used by the runtime services.
FROM mcr.microsoft.com/playwright:v1.65.1-noble AS frontend-ci
WORKDIR /app
COPY packages/contracts/package.json packages/contracts/package-lock.json packages/contracts/
COPY frontend/package.json frontend/package-lock.json frontend/
RUN npm ci --prefix packages/contracts && npm ci --prefix frontend
COPY . .
RUN npm --prefix packages/contracts run build
CMD ["sh", "/app/docker/verify-frontend.sh"]
