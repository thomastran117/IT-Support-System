# Optional Docker Compose overrides. The repository runs without a .env file.
# Values below are development placeholders, never production secrets.

# PostgreSQL (available only to containers on the internal network)
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=smartdesk
POSTGRES_DB=smartdesk

# Published host ports and browser-visible origins
FRONTEND_PORT=3000
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication
JWT_SECRET=change-me-dev-only-change-me-dev-only
JWT_ISSUER=smartdesk-api
JWT_AUDIENCE=smartdesk-web
# Optional JSON registry of caller public keys. Empty disables internal routes.
INTERNAL_SERVICE_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# Runtime behavior
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=5000
GATEWAY_UPSTREAM_TIMEOUT_MS=10000
# Private Ticket origin and credentials for the opt-in AI service.
AI_SERVICE_TICKET_ORIGIN=http://backend-api:4000
AI_SERVICE_READY_TIMEOUT_MS=1500
AI_SERVICE_KEY_ID=
AI_SERVICE_PRIVATE_KEY=
AI_SERVICE_API_KEY=
# Optional independent Notifications service. Use a login with smartdesk_notifications grants.
NOTIFICATIONS_EXECUTION_MODE=local
NOTIFICATIONS_DATABASE_URL=
NOTIFICATIONS_IDENTITY_ORIGIN=http://backend-api:4000
NOTIFICATIONS_KEY_ID=
NOTIFICATIONS_PRIVATE_KEY=
NOTIFICATIONS_SMTP_USER=
NOTIFICATIONS_SMTP_PASSWORD=
# Optional Analytics service. Use a login with smartdesk_analytics grants.
ANALYTICS_EXECUTION_MODE=local
ANALYTICS_DATABASE_URL=
ANALYTICS_IDENTITY_ORIGIN=http://backend-api:4000
ANALYTICS_KEY_ID=
ANALYTICS_PRIVATE_KEY=
# Optional independent Knowledge service and published retrieval.
KNOWLEDGE_EXECUTION_MODE=local
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_IDENTITY_ORIGIN=http://backend-api:4000
KNOWLEDGE_KEY_ID=
KNOWLEDGE_PRIVATE_KEY=
KNOWLEDGE_RETRIEVAL_ORIGIN=http://knowledge-api:4040
KNOWLEDGE_RETRIEVAL_KEYS=
KNOWLEDGE_WORKER_KEY_ID=
KNOWLEDGE_WORKER_PRIVATE_KEY=
# false (default) never trusts a forwarded-for header, so a client cannot spoof the IP the rate
# limiter keys on. This applies at the public gateway (or API in direct mode).
# Set true only if every request genuinely passes through your own reverse
# proxy, or a comma-separated list of that proxy's trusted IPs/CIDRs.
TRUST_PROXY=false

# Redis (optional internal cache, off by default). Leave REDIS_URL empty to run without it —
# /health/ready then reports cache as "disabled" rather than attempting a connection. To exercise
# it locally: docker compose --profile cache up -d redis, then set REDIS_URL=redis://redis:6379
# here (the in-network service name, not localhost) and restart the backend container.
REDIS_URL=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_MAXCLIENTS=100

# OpenSearch (optional, server-side only). See the README for the local search profile.
# Local profile endpoint: http://opensearch:9200. Production uses HTTPS and service credentials.
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# AI recommendations: none (disabled) | fake (deterministic, CI/dev) | openai.
# Use AI_API_KEY for local execution or AI_SERVICE_API_KEY for the independent container.
AI_EXECUTION_MODE=local
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_INPUT_CHARS=20000
# Background analysis worker (a separate process from the API).
AI_WORKER_CONCURRENCY=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_BACKOFF_MS=5000

# Optional email for notifications (the worker sends it). off | smtp. The in-app notification
# centre works the same with email off, and CI/local runs never send anything.
EMAIL_TRANSPORT=none
# Gmail setup: turn on 2-Step Verification for the sending account, create an App Password
# (Google Account > Security > App passwords) and put it in SMTP_PASSWORD. Your normal Gmail
# password does not work. Never commit real values: keep them in an untracked .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave empty for the default (STARTTLS on 587). Set true with SMTP_PORT=465 for implicit TLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER. Gmail rewrites it to the authenticated account unless an alias is verified.
SMTP_FROM=
# Origin used to build ticket links in emails.
APP_BASE_URL=http://localhost:3000
EMAIL_JOB_MAX_ATTEMPTS=5
EMAIL_JOB_BACKOFF_MS=30000
# Notifications older than this are never emailed (stale after an outage, or when switching email on).
EMAIL_MAX_AGE_HOURS=24
