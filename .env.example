# Copy to .env for local use. Values below are development placeholders, NOT secrets.
# Never commit a real .env.

# --- PostgreSQL ---
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=smartdesk
POSTGRES_DB=smartdesk
# Used when running backend/worker directly on the host (npm run dev); with
# Docker Compose the host name is the service name `postgres`.
DATABASE_URL=postgres://smartdesk:smartdesk@localhost:5432/smartdesk

# --- Backend ---
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth (placeholder until epic E02) ---
JWT_SECRET=change-me-dev-only

# --- Frontend ---
# Origin of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- AI provider (placeholder; leave empty/none for local development) ---
AI_PROVIDER=none
AI_API_KEY=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000
