{
  "name": "@smartdesk/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts prisma",
    "test": "npm run test:unit && npm run test:integration",
    "migrate": "prisma migrate deploy",
    "seed": "npm run db:seed",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "docs:db": "tsx scripts/generate-database-docs.ts",
    "test:db": "tsx scripts/test-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@smartdesk/contracts": "^0.0.0",
    "@smartdesk/db": "^0.0.0",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
