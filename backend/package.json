{
  "name": "@smartdesk/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:ticket": "node dist/ticketServer.js",
    "start:search-worker": "node dist/searchWorker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts prisma",
    "test": "npm run test:unit && npm run test:integration",
    "migrate": "prisma migrate deploy",
    "check:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "seed": "npm run db:seed",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "docs:db": "tsx scripts/generate-database-docs.ts",
    "test:db": "tsx scripts/test-db.ts",
    "eval:ai": "tsx scripts/evaluate-ai.ts",
    "baseline:routing": "tsx scripts/routing-baseline.ts",
    "search:init": "tsx scripts/init-search.ts",
    "search:requeue": "tsx scripts/requeue-search-index-job.ts",
    "outbox:notifications": "tsx scripts/notification-outbox.ts",
    "search:backfill": "tsx scripts/rebuild-search.ts",
    "search:reindex": "tsx scripts/rebuild-search.ts",
    "bench:cache": "tsx scripts/evaluate-cache.ts",
    "bench:search": "tsx scripts/evaluate-search.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@smartdesk/ai-analysis": "file:../packages/ai-analysis",
    "@smartdesk/analytics": "file:../packages/analytics",
    "@smartdesk/contracts": "file:../packages/contracts",
    "@smartdesk/db": "file:../packages/db",
    "@smartdesk/identity": "file:../packages/identity",
    "@smartdesk/knowledge": "file:../packages/knowledge",
    "@smartdesk/notifications": "file:../packages/notifications",
    "@smartdesk/service-runtime": "file:../packages/service-runtime",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
