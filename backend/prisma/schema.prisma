// SmartDesk core relational schema (epic E01, Deliverable 2 data dictionary).
//
// Conventions: snake_case SQL names via @map/@@map, UUID keys generated by PostgreSQL,
// TIMESTAMPTZ everywhere, and RESTRICT on every relation (history is deactivated, never cascaded).
// CHECK constraints, the composite assignee/team foreign key, extra indexes and the append-only
// audit trigger are not expressible in Prisma and live in hand-written SQL migrations (SD-007).
//
// The generated client is emitted into @smartdesk/db so backend and worker share it.

generator client {
  provider     = "prisma-client"
  output       = "../../packages/db/src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  email       String   @unique @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(120)
  role        String   @db.VarChar(16)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  /// Bumped to invalidate every outstanding JWT for this user (stateless revocation).
  tokenVersion Int     @default(0) @map("token_version")

  teamMemberships      TeamMember[]
  requestedTickets     Ticket[]               @relation("TicketRequester")
  assignedTickets      Ticket[]               @relation("TicketAssignee")
  comments             TicketComment[]
  events               TicketEvent[]
  reviewedRecs         AiRecommendation[]
  classificationLabels ClassificationLabel[]
  auditActions         AdminAuditLog[]        @relation("AuditActor")
  auditedChanges       AdminAuditLog[]        @relation("AuditTarget")
  notifications        Notification[]

  @@map("users")
}

model SupportTeam {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @map("team_id") @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  members             TeamMember[]
  tickets             Ticket[]
  proposedRecommended AiRecommendation[]

  @@map("support_teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team SupportTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignedTickets Ticket[] @relation("TicketAssigneeMembership")

  @@id([teamId, userId])
  @@index([userId], map: "idx_team_members_user")
  @@map("team_members")
}

model TicketCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tickets            Ticket[]
  articles           KnowledgeArticle[]
  proposedByRecs     AiRecommendation[]
  referenceForLabels ClassificationLabel[]

  @@map("ticket_categories")
}

model Ticket {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @map("ticket_id") @db.Uuid
  requesterId       String    @map("requester_id") @db.Uuid
  assignedTeamId    String?   @map("assigned_team_id") @db.Uuid
  assigneeId        String?   @map("assignee_id") @db.Uuid
  categoryId        String?   @map("category_id") @db.Uuid
  title             String    @db.VarChar(150)
  description       String
  status            String    @default("OPEN") @db.VarChar(16)
  priority          String    @default("UNSET") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionSummary String?   @map("resolution_summary")
  /// Optimistic concurrency token: incremented by every mutation.
  version           Int       @default(1)
  /// Client-chosen key that makes a retried submission resolve to the original ticket.
  idempotencyKey    String?   @map("idempotency_key") @db.VarChar(100)
  /// Posting time of the first public staff response (see domain/firstResponse.ts).
  firstResponseAt   DateTime? @map("first_response_at") @db.Timestamptz(6)

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  team      SupportTeam?    @relation(fields: [assignedTeamId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  category  TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Composite FK (assigned_team_id, assignee_id) -> team_members: an assignee must belong to the team.
  // MATCH SIMPLE: not checked when either column is NULL (see CHECK tickets_assignee_requires_team).
  assigneeMembership TeamMember? @relation("TicketAssigneeMembership", fields: [assignedTeamId, assigneeId], references: [teamId, userId], onDelete: Restrict)

  comments        TicketComment[]
  events          TicketEvent[]
  recommendations AiRecommendation[]
  analysisJobs    AiAnalysisJob[]
  notifications   Notification[]
  label           ClassificationLabel?

  @@index([requesterId, createdAt(sort: Desc)], map: "idx_tickets_requester_created")
  @@index([assignedTeamId, status, createdAt], map: "idx_tickets_team_status_created")
  @@index([categoryId, createdAt], map: "idx_tickets_category_created")
  @@unique([requesterId, idempotencyKey], map: "uq_tickets_requester_idempotency")
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("comment_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt], map: "idx_ticket_comments_ticket_created")
  @@map("ticket_comments")
}

model TicketEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(32)
  details    Json     @default("{}") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([ticketId, occurredAt, id], map: "idx_ticket_events_ticket_occurred")
  @@map("ticket_events")
}

model AiRecommendation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @map("recommendation_id") @db.Uuid
  ticketId           String    @map("ticket_id") @db.Uuid
  proposedCategoryId String?   @map("proposed_category_id") @db.Uuid
  proposedTeamId     String?   @map("proposed_team_id") @db.Uuid
  proposedPriority   String?   @map("proposed_priority") @db.VarChar(10)
  suggestion         String?
  confidence         Decimal?  @db.Decimal(4, 3)
  modelVersion       String    @map("model_version") @db.VarChar(100)
  reviewStatus       String    @default("PENDING") @map("review_status") @db.VarChar(12)
  reviewerId         String?   @map("reviewer_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes        String?   @map("review_notes")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Analysis job that produced this row (SD-036); UNIQUE makes persistence idempotent per attempt.
  jobId              String?   @unique(map: "uq_ai_recommendations_job") @map("job_id") @db.Uuid

  ticket           Ticket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  job              AiAnalysisJob?  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposedCategory TicketCategory? @relation(fields: [proposedCategoryId], references: [id], onDelete: Restrict)
  proposedTeam     SupportTeam?    @relation(fields: [proposedTeamId], references: [id], onDelete: Restrict)
  reviewer         User?           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  articles RecommendationArticle[]

  @@index([ticketId, createdAt, id], map: "idx_ai_recommendations_ticket_created")
  @@map("ai_recommendations")
}

model KnowledgeArticle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("article_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  title       String   @db.VarChar(200)
  body        String
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  category        TicketCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recommendations RecommendationArticle[]

  @@map("knowledge_articles")
}

model RecommendationArticle {
  recommendationId String @map("recommendation_id") @db.Uuid
  articleId        String @map("article_id") @db.Uuid
  relevanceRank    Int    @map("relevance_rank")

  recommendation AiRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@id([recommendationId, articleId])
  @@unique([recommendationId, relevanceRank], map: "uq_recommendation_articles_rank")
  @@index([articleId], map: "idx_recommendation_articles_article")
  @@map("recommendation_articles")
}

model ClassificationLabel {
  ticketId            String   @id @map("ticket_id") @db.Uuid
  referenceCategoryId String   @map("reference_category_id") @db.Uuid
  labelledBy          String   @map("labelled_by") @db.Uuid
  labelledAt          DateTime @default(now()) @map("labelled_at") @db.Timestamptz(6)

  ticket            Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  referenceCategory TicketCategory @relation(fields: [referenceCategoryId], references: [id], onDelete: Restrict)
  labeller          User           @relation(fields: [labelledBy], references: [id], onDelete: Restrict)

  @@index([referenceCategoryId], map: "idx_classification_labels_category")
  @@map("classification_labels")
}

/// Append-only record of administrator account actions (SD-017). Never holds credentials.
model AdminAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("audit_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(32)
  details      Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id], map: "idx_admin_audit_created")
  @@index([targetUserId, createdAt(sort: Desc)], map: "idx_admin_audit_target")
  @@map("admin_audit_log")
}

/// Durable AI analysis queue (SD-035): a transactional outbox claimed with SKIP LOCKED and a lease.
model AiAnalysisJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @map("job_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  requestId   String    @default(dbgenerated("gen_random_uuid()")) @map("request_id") @db.Uuid
  state       String    @default("QUEUED") @db.VarChar(10)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseToken  String?   @map("lease_token") @db.Uuid
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  errorKind   String?   @map("error_kind") @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  recommendation AiRecommendation?

  @@unique([ticketId, requestId], map: "uq_ai_analysis_jobs_ticket_request")
  @@index([state, runAfter], map: "idx_ai_jobs_claim")
  @@index([ticketId, createdAt(sort: Desc)], map: "idx_ai_jobs_ticket")
  @@map("ai_analysis_jobs")
}

/// In-app employee notification (SD-040), written in the same transaction as its ticket event.
/// (recipientId, eventId, type) deduplicates; no message text is stored.
model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  type        String    @db.VarChar(24)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User        @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  ticket    Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event     TicketEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([recipientId, eventId, type], map: "uq_notifications_recipient_event_type")
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_notifications_recipient_created")
  @@index([ticketId], map: "idx_notifications_ticket")
  @@map("notifications")
}
