        {
          "name": "ck_ai_recommendations_priority",
          "rule": "((proposed_priority IS NULL) OR ((proposed_priority)::text = ANY ((ARRAY['LOW'::character varying, 'MEDIUM'::character varying, 'HIGH'::character varying, 'CRITICAL'::character varying])::text[])))"
        },
        {
          "name": "ck_ai_recommendations_review_complete",
          "rule": "((((review_status)::text = 'PENDING'::text) AND (reviewer_id IS NULL) AND (reviewed_at IS NULL)) OR (((review_status)::text <> 'PENDING'::text) AND (reviewer_id IS NOT NULL) AND (reviewed_at IS NOT NULL)))"
        },
        {
          "name": "ck_ai_recommendations_review_status",
          "rule": "((review_status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'OVERRIDDEN'::character varying, 'REJECTED'::character varying])::text[]))"
        },
        {
          "name": "ck_ai_recommendations_reviewed_after_created",
          "rule": "((reviewed_at IS NULL) OR (reviewed_at >= created_at))"
        }
      ],
      "indexes": [
        {
          "name": "ai_recommendations_pkey",
          "columns": ["recommendation_id"],
          "unique": true
        },
        {
          "name": "idx_ai_recommendations_ticket_created",
          "columns": ["ticket_id", "created_at", "recommendation_id"],
          "unique": false
        }
      ]
    },
